# app
NEXT_PUBLIC_APP_URL = "https://automatic-speech-recognition.homes"
NEXT_PUBLIC_APP_NAME = "Automatic Speech Recognition"
NEXT_PUBLIC_APP_DESCRIPTION = "Plan and evaluate automatic speech recognition workflows for transcription, captions, search, compliance, and voice AI products."
NEXT_PUBLIC_APP_LOGO = "/logo-asr.svg"
NEXT_PUBLIC_APP_FAVICON = "/favicon-asr.svg"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/preview-asr.png"
NEXT_PUBLIC_DEFAULT_LOCALE = "en"
PUBLIC_SITE_ONLY = "false"

# persistent authentication
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SCHEMA_FILE = "./src/config/db/schema.postgres.ts"
AUTH_URL = "https://automatic-speech-recognition.homes"
AUTH_SECRET = ""
EMAIL_AUTH_ENABLED = "false"
GOOGLE_AUTH_ENABLED = "true"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "light"
